# Backend API URL
EXPO_PUBLIC_API_URL=https://fsl-backhand-production.up.railway.app/api

# Google OAuth – vyplň po vytvoření credentials na console.cloud.google.com
# Typ "iOS"     → bundle ID: cz.fsl.app
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=REPLACE_WITH_IOS_CLIENT_ID.apps.googleusercontent.com
# Typ "Android" → package: cz.fsl.app + SHA-1 z EAS (viz níže)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=REPLACE_WITH_ANDROID_CLIENT_ID.apps.googleusercontent.com
# Typ "Web application" → přidej authorized redirect URI: https://auth.expo.io/@taby9657/fsl-liga
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_WEB_CLIENT_ID.apps.googleusercontent.com
