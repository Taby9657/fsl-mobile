# Backend API URL (Railway)
EXPO_PUBLIC_API_URL=https://fsl-api.railway.app/api

# Stripe publishable key (začíná pk_live_ nebo pk_test_)
EXPO_PUBLIC_STRIPE_PK=pk_test_xxx

# Google OAuth Client IDs
# → console.cloud.google.com → Credentials → OAuth 2.0 Client ID
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxx.apps.googleusercontent.com
