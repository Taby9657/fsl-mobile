{
  "expo": {
    "name": "FSL",
    "slug": "fsl-liga",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0120"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cz.fsl.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Potřebujeme přístup k fotoaparátu pro nahrání profilové fotky.",
        "NSPhotoLibraryUsageDescription": "Potřebujeme přístup k fotkám pro nahrání profilové fotky a loga týmu."
      }
    },
    "android": {
      "package": "cz.fsl.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0120"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "FSL potřebuje přístup k fotkám pro profilovou fotku."
        }
      ]
    ],
    "scheme": "fsl",
    "newArchEnabled": false,
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c0ac3a9d-1c19-4b22-b4cf-f0fd29e535af"
      }
    }
  }
}
