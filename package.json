{
  "name": "fsl-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "postinstall": "node -e \"const fs=require('fs');const f='node_modules/react-native-screens/src/fabric/ScreenStackNativeComponent.ts';let c=fs.readFileSync(f,'utf8');if(c.includes('CodegenTypes as CT')){c=c.replace(\\\"import type { CodegenTypes as CT, ViewProps } from 'react-native';\\\",\\\"import type { ViewProps } from 'react-native';\\\\nimport type { WithDefault, DirectEventHandler } from 'react-native/Libraries/Types/CodegenTypes';\\\").replace(/CT\\\\.WithDefault/g,'WithDefault').replace(/CT\\\\.DirectEventHandler/g,'DirectEventHandler');fs.writeFileSync(f,c);console.log('Patched react-native-screens')}\"",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "build:dev": "eas build --platform ios --profile development",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "submit:ios": "bash scripts/submit-ios.sh",
    "preflight": "bash scripts/preflight.sh",
    "check:tokens": "node scripts/check-tokens.js",
    "release:ios": "bash scripts/release-ios.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "^6.0.0",
    "axios": "^1.7.2",
    "date-fns": "^3.6.0",
    "expo": "~55.0.28",
    "expo-apple-authentication": "~55.0.15",
    "expo-auth-session": "~55.0.17",
    "expo-blur": "~55.0.16",
    "expo-camera": "~55.0.21",
    "expo-dev-client": "~55.0.37",
    "expo-haptics": "~55.0.16",
    "expo-image-picker": "~55.0.22",
    "expo-linear-gradient": "~55.0.16",
    "expo-notifications": "~55.0.25",
    "expo-router": "~55.0.17",
    "expo-secure-store": "~55.0.16",
    "expo-status-bar": "~55.0.6",
    "expo-web-browser": "~55.0.18",
    "nativewind": "^4.0.1",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-worklets": "~0.7.0",
    "tailwindcss": "^3.4.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~55.0.8",
    "typescript": "~5.9.2"
  }
}
